# =============================================================================
# ZORVI — Environment template
# Copy to .env and fill in real values before running docker compose.
# NEVER commit .env.  This file IS safe to commit.
# =============================================================================

# ---------- PostgreSQL (container: zorvi_postgres) ----------
POSTGRES_USER=zorvi
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
POSTGRES_DB=zorvi

# Host-facing port (locked to 5434 to avoid your other projects)
POSTGRES_HOST_PORT=5434

# ---------- FastAPI backend ----------
# ZORVI backend is hard-locked to 8010 (8000 is used by ~/Projects/ZanNe…)
BACKEND_HOST_PORT=8010
BACKEND_HOST=127.0.0.1

# Connection string the backend uses to reach the ZORVI Postgres container.
# Note: 5434 is the HOST port; from inside the container it's 5432.
DATABASE_URL=postgresql+asyncpg://zorvi:REPLACE_WITH_A_STRONG_PASSWORD@127.0.0.1:5434/zorvi

# ---------- Security ----------
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_A_64_BYTE_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ---------- App ----------
PROJECT_NAME=ZORVI
PROJECT_TAGLINE=Learn. Create. Launch.
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
