# ZORVI / ibrant backend environment template. Copy to .env and replace placeholders.
# Never commit the real .env file. PostgreSQL is installed natively for local development.

PROJECT_NAME=ZORVI
PROJECT_TAGLINE=Learn. Create. Launch.
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=127.0.0.1
BACKEND_HOST_PORT=8001
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5174,http://127.0.0.1:5174

# Native PostgreSQL local example (host port 5434).
DATABASE_URL=postgresql+asyncpg://zorvi:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5434/zorvi
DATABASE_URL_SYNC=postgresql://zorvi:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5434/zorvi

# Generate a unique secret: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI build provider. Keep the API key on the backend only.
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_REQUEST_TIMEOUT_SECONDS=120

# Optional OAuth credentials; set only when OAuth providers are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
